{
  "name": "@xstate/desktop",
  "productName": "xstate",
  "version": "0.1.0",
  "description": "xstate for desktop",
  "private": true,
  "type": "module",
  "main": "main.js",
  "scripts": {
    "dev": "electron . --dev",
    "start": "pnpm --filter @xstate/www build && electron .",
    "dist": "pnpm --filter @xstate/www build && electron-builder",
    "dist:mac": "pnpm --filter @xstate/www build && electron-builder --mac",
    "dist:win": "pnpm --filter @xstate/www build && electron-builder --win",
    "dist:linux": "pnpm --filter @xstate/www build && electron-builder --linux"
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  },
  "devDependencies": {
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.xstate.desktop",
    "productName": "xstate",
    "files": [
      "main.js",
      "preload.cjs",
      "assets/**"
    ],
    "extraResources": [
      {
        "from": "../www/dist",
        "to": "web",
        "filter": [
          "**/*",
          "!**/.DS_Store"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage",
      "category": "Office"
    },
    "publish": {
      "provider": "generic",
      "url": "https://xstate.com/desktop/releases"
    }
  }
}
