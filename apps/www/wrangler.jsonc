{
  // xstate.com: the marketing site (public/) and the React app and sign-in pages (src/), built by Vite into dist/.
  // Static assets on Cloudflare Workers, no Worker script. `pnpm deploy` builds first (turbo.json).
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "xstate-www",
  "compatibility_date": "2026-09-20",
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  // xstate.com and www.xstate.com. A custom domain creates its own DNS record and certificate on deploy.
  "workers_dev": false,
  "routes": [
    { "pattern": "xstate.com", "custom_domain": true },
    { "pattern": "www.xstate.com", "custom_domain": true }
  ]
}
