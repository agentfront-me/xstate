{
  // xstate API: Hono on Cloudflare Workers.
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "xstate-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-20",
  // global_fetch_strictly_public: the MCP sign-in fetches connecting apps' Client ID Metadata Documents (mcp/oauth.ts).
  // The flag makes fetches to hosts in our own zone go out through the public internet like any other, which is
  // what stops such a document's URL from reaching something internal.
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "observability": { "enabled": true },
  // CPU per invocation. Migration jobs decode and upload mail for a few minutes at a time (migration/mail.ts); the
  // 30-second default is too tight for them. Only what's used is billed.
  "limits": { "cpu_ms": 300000 },
  // api.xstate.com, and mcp.xstate.com for the MCP server and its OAuth sign-in (mcp/oauth.ts decides by host).
  // A custom domain creates its own DNS record and certificate on deploy.
  "workers_dev": false,
  "routes": [
    { "pattern": "api.xstate.com", "custom_domain": true },
    { "pattern": "mcp.xstate.com", "custom_domain": true },
    // Calendar apps over CalDAV (dav/caldav.ts). mail.xstate.com, on deepo, redirects calendar apps here.
    { "pattern": "dav.xstate.com", "custom_domain": true },
    // MTA-STS policy for xstate.com, whose mail the store holds (mailbox/mta-sts.ts). One per store-held domain we
    // run DNS for; the domain's own mta-sts record must not exist when it is first deployed.
    { "pattern": "mta-sts.xstate.com", "custom_domain": true },
    { "pattern": "mta-sts.upfold.me", "custom_domain": true },
    { "pattern": "mta-sts.hireninja.com", "custom_domain": true },
    { "pattern": "mta-sts.asif.pk", "custom_domain": true }
  ],
  "vars": {
    "ENVIRONMENT": "production",
    // Mail and calendar apps (docs/imap-smtp-relay-plan.md): who can create app passwords and sign in with them while
    // IMAP, SMTP and CalDAV are being built. "off" nobody, "on" everybody, or organization ids separated by commas.
    // Launched to everyone 2026-11-20.
    "MAIL_APPS": "on",
    // Browser origins allowed to call the API (comma-separated): the dashboard and sign-up pages (go.xstate.com),
    // and the desktop app, which serves the dashboard from app://xstate. xstate.com stays listed because Domain
    // Connect returns there (a redirect_uri is only signed when it's on one of these origins).
    "APP_ORIGINS": "https://go.xstate.com,https://xstate.com,https://www.xstate.com,app://xstate",
    // Cloudflare account that holds the organizations' R2 buckets (xstate-org-<id>).
    "CLOUDFLARE_ACCOUNT_ID": "99322c1871edd6eb7fba729f872c1832",
    // SNS topics allowed to post SES bounces and complaints to /webhooks/ses (comma-separated).
    "SES_SNS_TOPIC_ARNS": "arn:aws:sns:us-east-2:881901370832:xstate-ses-events",
    // Amazon SES region for outbound mail and domain registration (mailserver/ses.ts).
    "AWS_SES_REGION": "us-east-2",
    // How domains are registered with SES: "live" (real SES, needs the AWS_SES_* secrets), "fake" (made-up DKIM
    // tokens, verified on the next check: for local dev) or "off" (skip SES). Local dev sets it in .dev.vars.
    "SES_MODE": "live",
    // Outside production only: one shared bucket for every organization instead of a bucket each, so local dev
    // needs no bucket-creating token (an R2 token scoped to this bucket is enough). Empty in production.
    "R2_BUCKET": "",
    // One-click DNS setup (Domain Connect, docs/domain-connect/). Apply links are signed with
    // DOMAIN_CONNECT_PRIVATE_KEY, whose public key is published as TXT at <DOMAIN_CONNECT_KEY_HOST>.xstate.io (the
    // template's syncPubKeyDomain). Cloudflare onboarded the template on 2026-11-17 in test mode: it works only for
    // our own Cloudflare account, so DOMAIN_CONNECT_TEST_DOMAINS limits the button to asif.co. Set it to "" once
    // Cloudflare puts the template live, and every domain gets it.
    "DOMAIN_CONNECT_ENABLED": "true",
    "DOMAIN_CONNECT_KEY_HOST": "_dck1",
    "DOMAIN_CONNECT_TEST_DOMAINS": "asif.co",
    // Where links in xstate's own emails point (invites: <APP_URL>/invite/#token). Local dev sets it in .dev.vars.
    "APP_URL": "https://go.xstate.com",
    // xstate's own mail (invites) is sent from this mailbox, which has to exist in xstate's organization. Empty:
    // nothing is sent, and outside production the API hands back the invite link instead (mailserver/system-mail.ts).
    "SYSTEM_MAIL_FROM": "no-reply@xstate.com",
    // Google Workspace imports (migration/): "live" uses GOOGLE_MIGRATION_KEY (the service account's JSON key, a
    // secret; not in "required" so deploys work before it exists), "fake" a made-up Workspace for local dev.
    "GOOGLE_MODE": "live",
    // Agents (agents/model.ts): an AI Gateway on this account that model calls go through, for per-request logs,
    // token counts and rate limits. Empty: calls go straight to the provider.
    "AI_GATEWAY_ID": "",
    // This API's own public origin, for the webhook URLs agents' triggers show (agents/triggers.ts).
    "API_URL": "https://api.xstate.com",
    // Where the MCP server and its OAuth sign-in are published (mcp/oauth.ts): the OAuth issuer, and <MCP_URL>/mcp
    // is what people paste into their AI app. Local dev sets it to the API's own address in .dev.vars.
    "MCP_URL": "https://mcp.xstate.com",
    // Receiving through SES (mailbox/receive.ts, docs/mailbox-store-plan.md phase 2): the SNS topic whose notifications
    // /webhooks/ses-inbound accepts. Empty: receiving is off and the endpoint answers 404. Needs the
    // MAIL_INBOUND_ACCESS_KEY_ID and MAIL_INBOUND_SECRET_ACCESS_KEY secrets. Setup: docs/mailbox-store-plan.md,
    // "Step 1 setup". Nothing is received until the SES receipt rule is active.
    "SES_INBOUND_TOPIC_ARN": "arn:aws:sns:us-east-2:881901370832:xstate-mail-inbound",
    // Billing (billing/, docs/billing-limits-plan.md): the payment provider billing/provider.ts uses. Its keys are
    // secrets; until they are set, paid plans can't be bought and Settings → Billing says so.
    "BILLING_PROVIDER": "stripe"
  },
  // Connected apps (mcp/oauth.ts): registered clients, grants and tokens, kept by @cloudflare/workers-oauth-provider
  // (tokens only as hashes), and sign-in requests waiting on the consent page for up to 10 minutes. Namespace
  // "xstate-api-oauth", created by hand: the deploy token can't create namespaces. Local dev uses a local copy.
  "kv_namespaces": [{ "binding": "OAUTH_KV", "id": "4a0a11ef054d4b2197cedfaa3617eaaf" }],
  // Users, organizations, domains and mailboxes. Schema lives in migrations/.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "xstate",
      "database_id": "215ca842-0591-4fc4-8f6f-0e61cc77b1ea",
      "migrations_dir": "migrations"
    }
  ],
  // Storage search (search/): every new file version and attachment is queued for indexing; the consumer extracts
  // its text, embeds it with Workers AI and writes the vectors to Vectorize. Create once: wrangler queues create xstate-search-index
  // Push notifications to the mobile app (push/send.ts): anything that notifies queues a job here, and the consumer
  // sends through Expo. Create once: wrangler queues create xstate-push
  "queues": {
    "producers": [
      { "binding": "SEARCH_INDEX", "queue": "xstate-search-index" },
      { "binding": "MIGRATION", "queue": "xstate-migration" },
      { "binding": "PUSH", "queue": "xstate-push" },
      { "binding": "MAIL_IN", "queue": "xstate-mail-in" },
      { "binding": "MAIL_EVENTS", "queue": "xstate-mail-events" }
    ],
    "consumers": [
      { "queue": "xstate-push", "max_batch_size": 10, "max_batch_timeout": 1, "max_retries": 5 },
      // At most 3 at once: a migration queues thousands of emails, and Vectorize refuses writes that arrive too fast.
      { "queue": "xstate-search-index", "max_batch_size": 10, "max_batch_timeout": 5, "max_retries": 10, "max_concurrency": 3 },
      // Imports from Google Workspace (migration/jobs.ts). Few at a time, so a big import can't crowd out the other
      // queues. Create once: wrangler queues create xstate-migration
      { "queue": "xstate-migration", "max_batch_size": 1, "max_batch_timeout": 1, "max_retries": 5, "max_concurrency": 5, "dead_letter_queue": "xstate-migration-dlq" },
      // Migration jobs that ran out of retries without our code seeing an error (the Worker was killed for memory or
      // CPU): marked as needing attention so the copy can't stall silently (migration/jobs.ts consumeMigrationDead).
      // Create once: wrangler queues create xstate-migration-dlq
      { "queue": "xstate-migration-dlq", "max_batch_size": 1, "max_batch_timeout": 1, "max_retries": 3 },
      // Mail received through SES for mailboxes whose mail the store holds (mailbox/receive.ts). 4 a batch, handled
      // one at a time, since a message can be 40 MB. After 5 tries a job waits in the dead-letter queue, and the
      // message in S3 for 7 days. Create once: wrangler queues create xstate-mail-in, and xstate-mail-in-dlq
      { "queue": "xstate-mail-in", "max_batch_size": 4, "max_batch_timeout": 1, "max_retries": 5, "dead_letter_queue": "xstate-mail-in-dlq" },
      // New-mail events for mailboxes the store holds (mailbox/events.ts): attachments filed, mail indexed for search,
      // received mail offered to agents. 4 a batch, one message read at a time. Create once: wrangler queues create
      // xstate-mail-events, and xstate-mail-events-dlq
      { "queue": "xstate-mail-events", "max_batch_size": 4, "max_batch_timeout": 2, "max_retries": 8, "dead_letter_queue": "xstate-mail-events-dlq" }
    ]
  },
  // Workers AI: the embedding model (@cf/baai/bge-m3) and toMarkdown for PDFs. Always runs remotely, in dev too.
  "ai": { "binding": "AI", "remote": true },
  // Vectorize has no local simulator, and dev must never touch production vectors, so there are two bindings and
  // search/vectors.ts picks by ENVIRONMENT: SEARCH in production, SEARCH_DEV (remote) under wrangler dev. The index
  // is named after the embedding model: a model change is a new index and a backfill. Create once:
  //   wrangler vectorize create xstate-search-bge-m3 --dimensions=1024 --metric=cosine
  //   wrangler vectorize create-metadata-index xstate-search-bge-m3 --property-name=<top|space|owner|doc> --type=string
  "vectorize": [
    { "binding": "SEARCH", "index_name": "xstate-search-bge-m3" },
    { "binding": "SEARCH_DEV", "index_name": "xstate-search-dev", "remote": true }
  ],
  // storage_search: 60 calls a minute per user (each one is an embedding call and up to several Vectorize queries).
  // The namespace id only has to be unique within this Worker.
  // COLLECT_RATE: audience events from browsers, 300 a minute per organization and visitor IP (audience/collect.ts).
  "ratelimits": [
    { "name": "SEARCH_RATE", "namespace_id": "1001", "simple": { "limit": 60, "period": 60 } },
    { "name": "COLLECT_RATE", "namespace_id": "1002", "simple": { "limit": 300, "period": 60 } },
    // HOOK_RATE: agents' webhook triggers, 60 a minute per trigger (agents/triggers.ts).
    { "name": "HOOK_RATE", "namespace_id": "1003", "simple": { "limit": 60, "period": 60 } },
    // Sign-in and sign-up throttling (auth/throttle.ts). LOGIN_IP_RATE: 10 sign-in attempts a minute per IP, against
    // password spraying. LOGIN_EMAIL_RATE: 5 a minute per email address, against one account being guessed from many
    // IPs. REGISTER_IP_RATE: 5 sign-ups a minute per IP. Soft limits: nobody is locked out for longer than a minute.
    { "name": "LOGIN_IP_RATE", "namespace_id": "1004", "simple": { "limit": 10, "period": 60 } },
    { "name": "LOGIN_EMAIL_RATE", "namespace_id": "1005", "simple": { "limit": 5, "period": 60 } },
    { "name": "REGISTER_IP_RATE", "namespace_id": "1006", "simple": { "limit": 5, "period": 60 } },
    // MCP_RATE: tool calls from a connected AI app, 120 a minute per person, app and organization (mcp/server.ts).
    { "name": "MCP_RATE", "namespace_id": "1007", "simple": { "limit": 120, "period": 60 } },
    // TOKEN_FAIL_RATE: requests with a wrong personal API token, 20 a minute per IP (auth/middleware.ts requireToken).
    { "name": "TOKEN_FAIL_RATE", "namespace_id": "1008", "simple": { "limit": 20, "period": 60 } },
    // EMAILS_RATE: calls to /v1/emails, 300 a minute per personal API token. Sending itself is held by the caps in
    // mailserver/sending.ts; this keeps a loop that only reads the send log from hammering D1.
    { "name": "EMAILS_RATE", "namespace_id": "1009", "simple": { "limit": 300, "period": 60 } },
    // Mail and calendar apps signing in with an app password (auth/app-passwords.ts): 10 tries a minute per address,
    // and a loose 300 a minute per IP, because some apps connect from their maker's servers.
    { "name": "APP_LOGIN_ADDRESS_RATE", "namespace_id": "1010", "simple": { "limit": 10, "period": 60 } },
    { "name": "APP_LOGIN_IP_RATE", "namespace_id": "1011", "simple": { "limit": 300, "period": 60 } }
  ],
  // Audience (the Users section): one Durable Object per organization, with its own SQLite database of people,
  // events and segments (audience/store.ts). Kept out of D1 so website tracking can't slow sign-in or mail.
  // Google Workspace imports: one MigrationStore per organization, the map of what was copied (migration/store.ts).
  // Agents: one AgentStore per agent (its runs, run steps and usage; agents/store.ts).
  "durable_objects": {
    "bindings": [
      { "name": "AUDIENCE", "class_name": "AudienceStore" },
      { "name": "MIGRATION_STORE", "class_name": "MigrationStore" },
      { "name": "AGENT_STORE", "class_name": "AgentStore" },
      // One per organization: the mobile app's live-updates sockets (live/hub.ts).
      { "name": "LIVE", "class_name": "LiveHub" },
      // One per mailbox: its message index (mailbox/store.ts, docs/mailbox-store-plan.md).
      { "name": "MAILBOX_STORE", "class_name": "MailboxStore" },
      // One per mail-app connection: its IMAP session (relay/imap-session.ts, docs/imap-smtp-relay-plan.md).
      { "name": "IMAP_SESSION", "class_name": "ImapSession" },
      // One per mail-app sending connection: its SMTP session (relay/smtp-session.ts).
      { "name": "SMTP_SESSION", "class_name": "SmtpSession" }
    ]
  },
  "migrations": [
    { "tag": "v1-audience", "new_sqlite_classes": ["AudienceStore"] },
    { "tag": "v2-migration-store", "new_sqlite_classes": ["MigrationStore"] },
    { "tag": "v3-agent-store", "new_sqlite_classes": ["AgentStore"] },
    { "tag": "v4-live-hub", "new_sqlite_classes": ["LiveHub"] },
    { "tag": "v5-mailbox-store", "new_sqlite_classes": ["MailboxStore"] },
    { "tag": "v6-imap-session", "new_sqlite_classes": ["ImapSession"] },
    { "tag": "v7-smtp-session", "new_sqlite_classes": ["SmtpSession"] }
  ],
  // One agent run = one AgentRun instance (agents/run.ts): every model and tool call is a durable step.
  "workflows": [{ "name": "xstate-agent-run", "binding": "AGENT_RUN", "class_name": "AgentRun" }],
  // Hourly: clean-ups (jobs/hourly.ts), such as the purge of files and mail deleted over 30 days ago.
  "triggers": { "crons": ["0 * * * *"] },
  // Set with `wrangler secret put <NAME>`; locally in .dev.vars.
  // AWS_SES_ACCESS_KEY_ID / AWS_SES_SECRET_ACCESS_KEY: IAM user that manages SES identities (not sending).
  // R2_ACCESS_KEY_ID / R2_SECRET_ACCESS_KEY: an R2 API token's S3 keys, Object Read & Write on all buckets.
  // CLOUDFLARE_API_TOKEN: an API token with "Workers R2 Storage Write", to create and delete buckets.
  // API_KEYS_ENCRYPTION_KEY: encrypts organizations' secret API keys at rest (audience/keys.ts). Any long random
  // string (openssl rand -base64 48). Changing it makes every stored secret key unreadable, so set it once.
  // MAIL_INBOUND_ACCESS_KEY_ID / MAIL_INBOUND_SECRET_ACCESS_KEY (optional until receiving is on): IAM user
  // xstate-mail-inbound, allowed only to read, write (the quarantine copy) and delete in the S3 bucket SES saves
  // received mail to.
  // MAIL_SEND_ACCESS_KEY_ID / MAIL_SEND_SECRET_ACCESS_KEY (optional until a store-held mailbox sends): IAM user
  // xstate-mail-send, allowed only ses:SendRawEmail, for mail sent straight through SES (mailbox/ses-send.ts).
  // DOMAIN_CONNECT_PRIVATE_KEY (set in production; without it there is no one-click setup): RSA key that signs Domain
  // Connect apply links; scripts/domain-connect-key.sh makes one. Not in "required" so deploys work without it.
  // XSTATE_SECRET_KEY (optional; without it nothing is sent): the secret key (sk_live_…) of the main organization's
  // Analytics, for xstate's own product analytics (src/analytics/events.ts, docs/analytics-events.md). Signs the
  // identify() hash in auth responses and authorizes server events to /v1/collect. Not in "required" so local dev
  // and deploys work without it.
  // RELAY_SECRET (optional; without it /relay/* does not exist): the secret the mail bridge on deepo sends when it
  // hands over a mail app's connection (relay/route.ts). Any long random string; the same value goes in the
  // bridge's secret file.
  // STRIPE_SECRET_KEY / STRIPE_WEBHOOK_SECRET (billing/stripe.ts): the Stripe secret key (sk_live_… in production) and
  // the signing secret (whsec_…) of the endpoint https://api.xstate.com/webhooks/billing/stripe. Required, because
  // wrangler dev only loads required secrets from .dev.vars; until live keys exist, set both to "off" and billing
  // stays unavailable (anything not starting sk_ / whsec_ counts as unset).
  "secrets": {
    "required": [
      "JWT_SECRET",
      "R2_ACCESS_KEY_ID",
      "R2_SECRET_ACCESS_KEY",
      "CLOUDFLARE_API_TOKEN",
      "AWS_SES_ACCESS_KEY_ID",
      "AWS_SES_SECRET_ACCESS_KEY",
      "API_KEYS_ENCRYPTION_KEY",
      "STRIPE_SECRET_KEY",
      "STRIPE_WEBHOOK_SECRET"
    ]
  }
}
