{
  // xstate API: Hono on Cloudflare Workers.
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "xstate-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-20",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // CPU per invocation. Migration jobs decode and upload mail for a few minutes at a time (migration/mail.ts); the
  // 30-second default is too tight for them. Only what's used is billed.
  "limits": { "cpu_ms": 300000 },
  // api.xstate.com. A custom domain creates its own DNS record and certificate on deploy.
  "workers_dev": false,
  "routes": [{ "pattern": "api.xstate.com", "custom_domain": true }],
  "vars": {
    "ENVIRONMENT": "production",
    "STALWART_URL": "https://mx.xstate.io",
    // Browser origins allowed to call the API (comma-separated): the dashboard and sign-up pages (go.xstate.com),
    // and the desktop app, which serves the dashboard from app://xstate. xstate.com stays listed because Domain
    // Connect returns there (a redirect_uri is only signed when it's on one of these origins).
    "APP_ORIGINS": "https://go.xstate.com,https://xstate.com,https://www.xstate.com,app://xstate",
    // Cloudflare account that holds the organizations' R2 buckets (xstate-org-<id>).
    "CLOUDFLARE_ACCOUNT_ID": "99322c1871edd6eb7fba729f872c1832",
    // SNS topics allowed to post SES bounces and complaints to /webhooks/ses (comma-separated).
    "SES_SNS_TOPIC_ARNS": "arn:aws:sns:us-east-2:881901370832:xstate-ses-events",
    // Amazon SES region for outbound mail and domain registration (mailserver/ses.ts).
    "AWS_SES_REGION": "us-east-2",
    // How domains are registered with SES: "live" (real SES, needs the AWS_SES_* secrets), "fake" (made-up DKIM
    // tokens, verified on the next check: for local dev) or "off" (skip SES). Local dev sets it in .dev.vars.
    "SES_MODE": "live",
    // Outside production only: one shared bucket for every organization instead of a bucket each, so local dev
    // needs no bucket-creating token (an R2 token scoped to this bucket is enough). Empty in production.
    "R2_BUCKET": "",
    // One-click DNS setup (Domain Connect, docs/domain-connect/). Keep "false" until the template is merged into
    // github.com/Domain-Connect/Templates and Cloudflare has onboarded it; until then onboarding shows only the
    // records table. Apply links are signed with DOMAIN_CONNECT_PRIVATE_KEY, whose public key is published as TXT
    // at <DOMAIN_CONNECT_KEY_HOST>.xstate.io (the template's syncPubKeyDomain).
    "DOMAIN_CONNECT_ENABLED": "false",
    "DOMAIN_CONNECT_KEY_HOST": "_dck1",
    // Where links in xstate's own emails point (invites: <APP_URL>/invite/#token). Local dev sets it in .dev.vars.
    "APP_URL": "https://go.xstate.com",
    // xstate's own mail (invites) is sent from this mailbox, which has to exist in xstate's organization. Empty:
    // nothing is sent, and outside production the API hands back the invite link instead (mailserver/system-mail.ts).
    "SYSTEM_MAIL_FROM": "no-reply@xstate.com",
    // Google Workspace imports (migration/): "live" uses GOOGLE_MIGRATION_KEY (the service account's JSON key, a
    // secret; not in "required" so deploys work before it exists), "fake" a made-up Workspace for local dev.
    "GOOGLE_MODE": "live",
    // Agents (agents/model.ts): an AI Gateway on this account that model calls go through, for per-request logs,
    // token counts and rate limits. Empty: calls go straight to the provider.
    "AI_GATEWAY_ID": "",
    // This API's own public origin, for the webhook URLs agents' triggers show (agents/triggers.ts).
    "API_URL": "https://api.xstate.com",
    // Virus scanning of composer and Storage uploads (security/scan.ts), by the scan service next to Stalwart
    // (apps/scanner): "live" refuses infected files, and every file while the scanner is unreachable; "log" scans
    // and logs but refuses nothing (the first week); "fake" flags only the EICAR test file (local dev); "off" skips
    // scanning. Needs the SCAN_SECRET secret. Mail arriving over SMTP is scanned on the mail server either way.
    "SCAN_MODE": "log",
    "SCAN_URL": "https://mx.xstate.io/_scan"
  },
  // Users, organizations, domains and mailboxes. Schema lives in migrations/.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "xstate",
      "database_id": "215ca842-0591-4fc4-8f6f-0e61cc77b1ea",
      "migrations_dir": "migrations"
    }
  ],
  // Mail sync jobs: Stalwart's webhook (POST /webhooks/stalwart) and the hourly check queue one job per mailbox;
  // the consumer copies new attachments to the organization's R2 bucket. Create once: wrangler queues create xstate-mail-sync
  // Storage search (search/): every new file version and attachment is queued for indexing; the consumer extracts
  // its text, embeds it with Workers AI and writes the vectors to Vectorize. Create once: wrangler queues create xstate-search-index
  // Push notifications to the mobile app (push/send.ts): anything that notifies queues a job here, and the consumer
  // sends through Expo. Create once: wrangler queues create xstate-push
  "queues": {
    "producers": [
      { "binding": "MAIL_SYNC", "queue": "xstate-mail-sync" },
      { "binding": "SEARCH_INDEX", "queue": "xstate-search-index" },
      { "binding": "MIGRATION", "queue": "xstate-migration" },
      { "binding": "PUSH", "queue": "xstate-push" }
    ],
    "consumers": [
      { "queue": "xstate-mail-sync", "max_batch_size": 10, "max_batch_timeout": 2, "max_retries": 10 },
      { "queue": "xstate-push", "max_batch_size": 10, "max_batch_timeout": 1, "max_retries": 5 },
      // At most 3 at once: a migration queues thousands of emails, and Vectorize refuses writes that arrive too fast.
      { "queue": "xstate-search-index", "max_batch_size": 10, "max_batch_timeout": 5, "max_retries": 10, "max_concurrency": 3 },
      // Imports from Google Workspace (migration/jobs.ts). Few at a time, so a big import can't crowd out mail
      // sync or swamp Stalwart. Create once: wrangler queues create xstate-migration
      { "queue": "xstate-migration", "max_batch_size": 1, "max_batch_timeout": 1, "max_retries": 5, "max_concurrency": 5, "dead_letter_queue": "xstate-migration-dlq" },
      // Migration jobs that ran out of retries without our code seeing an error (the Worker was killed for memory or
      // CPU): marked as needing attention so the copy can't stall silently (migration/jobs.ts consumeMigrationDead).
      // Create once: wrangler queues create xstate-migration-dlq
      { "queue": "xstate-migration-dlq", "max_batch_size": 1, "max_batch_timeout": 1, "max_retries": 3 }
    ]
  },
  // Workers AI: the embedding model (@cf/baai/bge-m3) and toMarkdown for PDFs. Always runs remotely, in dev too.
  "ai": { "binding": "AI", "remote": true },
  // Vectorize has no local simulator, and dev must never touch production vectors, so there are two bindings and
  // search/vectors.ts picks by ENVIRONMENT: SEARCH in production, SEARCH_DEV (remote) under wrangler dev. The index
  // is named after the embedding model: a model change is a new index and a backfill. Create once:
  //   wrangler vectorize create xstate-search-bge-m3 --dimensions=1024 --metric=cosine
  //   wrangler vectorize create-metadata-index xstate-search-bge-m3 --property-name=<top|space|owner|doc> --type=string
  "vectorize": [
    { "binding": "SEARCH", "index_name": "xstate-search-bge-m3" },
    { "binding": "SEARCH_DEV", "index_name": "xstate-search-dev", "remote": true }
  ],
  // storage_search: 60 calls a minute per user (each one is an embedding call and up to several Vectorize queries).
  // The namespace id only has to be unique within this Worker.
  // COLLECT_RATE: audience events from browsers, 300 a minute per organization and visitor IP (audience/collect.ts).
  "ratelimits": [
    { "name": "SEARCH_RATE", "namespace_id": "1001", "simple": { "limit": 60, "period": 60 } },
    { "name": "COLLECT_RATE", "namespace_id": "1002", "simple": { "limit": 300, "period": 60 } },
    // HOOK_RATE: agents' webhook triggers, 60 a minute per trigger (agents/triggers.ts).
    { "name": "HOOK_RATE", "namespace_id": "1003", "simple": { "limit": 60, "period": 60 } },
    // Sign-in and sign-up throttling (auth/throttle.ts). LOGIN_IP_RATE: 10 sign-in attempts a minute per IP, against
    // password spraying. LOGIN_EMAIL_RATE: 5 a minute per email address, against one account being guessed from many
    // IPs. REGISTER_IP_RATE: 5 sign-ups a minute per IP. Soft limits: nobody is locked out for longer than a minute.
    { "name": "LOGIN_IP_RATE", "namespace_id": "1004", "simple": { "limit": 10, "period": 60 } },
    { "name": "LOGIN_EMAIL_RATE", "namespace_id": "1005", "simple": { "limit": 5, "period": 60 } },
    { "name": "REGISTER_IP_RATE", "namespace_id": "1006", "simple": { "limit": 5, "period": 60 } }
  ],
  // Audience (the Users section): one Durable Object per organization, with its own SQLite database of people,
  // events and segments (audience/store.ts). Kept out of D1 so website tracking can't slow sign-in or mail.
  // Google Workspace imports: one MigrationStore per organization, the map of what was copied (migration/store.ts).
  // Agents: one AgentStore per agent (its runs, run steps and usage; agents/store.ts).
  "durable_objects": {
    "bindings": [
      { "name": "AUDIENCE", "class_name": "AudienceStore" },
      { "name": "MIGRATION_STORE", "class_name": "MigrationStore" },
      { "name": "AGENT_STORE", "class_name": "AgentStore" },
      // One per organization: the mobile app's live-updates sockets (live/hub.ts).
      { "name": "LIVE", "class_name": "LiveHub" }
    ]
  },
  "migrations": [
    { "tag": "v1-audience", "new_sqlite_classes": ["AudienceStore"] },
    { "tag": "v2-migration-store", "new_sqlite_classes": ["MigrationStore"] },
    { "tag": "v3-agent-store", "new_sqlite_classes": ["AgentStore"] },
    { "tag": "v4-live-hub", "new_sqlite_classes": ["LiveHub"] }
  ],
  // One agent run = one AgentRun instance (agents/run.ts): every model and tool call is a durable step.
  "workflows": [{ "name": "xstate-agent-run", "binding": "AGENT_RUN", "class_name": "AgentRun" }],
  // Hourly: safety-net mail sync (in case webhooks were lost) and purge of files deleted over 30 days ago.
  "triggers": { "crons": ["0 * * * *"] },
  // Set with `wrangler secret put <NAME>`; locally in .dev.vars.
  // STALWART_WEBHOOK_SECRET: HMAC key shared with the WebHook object on Stalwart (signatureKey).
  // AWS_SES_ACCESS_KEY_ID / AWS_SES_SECRET_ACCESS_KEY: IAM user that manages SES identities (not sending).
  // R2_ACCESS_KEY_ID / R2_SECRET_ACCESS_KEY: an R2 API token's S3 keys, Object Read & Write on all buckets.
  // CLOUDFLARE_API_TOKEN: an API token with "Workers R2 Storage Write", to create and delete buckets.
  // API_KEYS_ENCRYPTION_KEY: encrypts organizations' secret API keys at rest (audience/keys.ts). Any long random
  // string (openssl rand -base64 48). Changing it makes every stored secret key unreadable, so set it once.
  // SCAN_SECRET (optional while SCAN_MODE is "off"): shared with the scan service on the mail server
  // (apps/scanner/deploy/README.md). Not in "required" so deploys work before the scanner exists.
  // DOMAIN_CONNECT_PRIVATE_KEY (optional until DOMAIN_CONNECT_ENABLED is "true"): RSA key that signs Domain
  // Connect apply links; scripts/domain-connect-key.sh makes one. Not in "required" so deploys work without it.
  "secrets": {
    "required": [
      "STALWART_API_KEY",
      "JWT_SECRET",
      "R2_ACCESS_KEY_ID",
      "R2_SECRET_ACCESS_KEY",
      "CLOUDFLARE_API_TOKEN",
      "STALWART_WEBHOOK_SECRET",
      "AWS_SES_ACCESS_KEY_ID",
      "AWS_SES_SECRET_ACCESS_KEY",
      "API_KEYS_ENCRYPTION_KEY"
    ]
  }
}
