{
  // xstate API: Hono on Cloudflare Workers.
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "xstate-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-20",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // api.xstate.com. A custom domain creates its own DNS record and certificate on deploy.
  "workers_dev": false,
  "routes": [{ "pattern": "api.xstate.com", "custom_domain": true }],
  "vars": {
    "ENVIRONMENT": "production",
    "STALWART_URL": "https://mx.xstate.io",
    // Browser origins allowed to call the API (comma-separated): the site's sign-up pages and dashboard, and the
    // desktop app, which serves the dashboard from app://xstate.
    "APP_ORIGINS": "https://xstate.com,https://www.xstate.com,app://xstate",
    // Cloudflare account that holds the organizations' R2 buckets (xstate-org-<id>).
    "CLOUDFLARE_ACCOUNT_ID": "99322c1871edd6eb7fba729f872c1832",
    // SNS topics allowed to post SES bounces and complaints to /webhooks/ses (comma-separated).
    "SES_SNS_TOPIC_ARNS": "arn:aws:sns:us-east-2:881901370832:xstate-ses-events",
    // Amazon SES region for outbound mail and domain registration (mailserver/ses.ts).
    "AWS_SES_REGION": "us-east-2",
    // How domains are registered with SES: "live" (real SES, needs the AWS_SES_* secrets), "fake" (made-up DKIM
    // tokens, verified on the next check: for local dev) or "off" (skip SES). Local dev sets it in .dev.vars.
    "SES_MODE": "live",
    // Outside production only: one shared bucket for every organization instead of a bucket each, so local dev
    // needs no bucket-creating token (an R2 token scoped to this bucket is enough). Empty in production.
    "R2_BUCKET": ""
  },
  // Users, organizations, domains and mailboxes. Schema lives in migrations/.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "xstate",
      "database_id": "215ca842-0591-4fc4-8f6f-0e61cc77b1ea",
      "migrations_dir": "migrations"
    }
  ],
  // Mail sync jobs: Stalwart's webhook (POST /webhooks/stalwart) and the hourly check queue one job per mailbox;
  // the consumer copies new attachments to the organization's R2 bucket. Create once: wrangler queues create xstate-mail-sync
  "queues": {
    "producers": [{ "binding": "MAIL_SYNC", "queue": "xstate-mail-sync" }],
    "consumers": [{ "queue": "xstate-mail-sync", "max_batch_size": 10, "max_batch_timeout": 2, "max_retries": 10 }]
  },
  // Hourly: safety-net mail sync (in case webhooks were lost) and purge of files deleted over 30 days ago.
  "triggers": { "crons": ["0 * * * *"] },
  // Set with `wrangler secret put <NAME>`; locally in .dev.vars.
  // STALWART_WEBHOOK_SECRET: HMAC key shared with the WebHook object on Stalwart (signatureKey).
  // AWS_SES_ACCESS_KEY_ID / AWS_SES_SECRET_ACCESS_KEY: IAM user that manages SES identities (not sending).
  // R2_ACCESS_KEY_ID / R2_SECRET_ACCESS_KEY: an R2 API token's S3 keys, Object Read & Write on all buckets.
  // CLOUDFLARE_API_TOKEN: an API token with "Workers R2 Storage Write", to create and delete buckets.
  "secrets": {
    "required": [
      "STALWART_API_KEY",
      "JWT_SECRET",
      "R2_ACCESS_KEY_ID",
      "R2_SECRET_ACCESS_KEY",
      "CLOUDFLARE_API_TOKEN",
      "STALWART_WEBHOOK_SECRET",
      "AWS_SES_ACCESS_KEY_ID",
      "AWS_SES_SECRET_ACCESS_KEY"
    ]
  }
}
