# Copy to .dev.vars for `wrangler dev`. Production values are set with `wrangler secret put <NAME>`.
ENVIRONMENT=development
STALWART_URL=https://mx.xstate.com
# The www dev server, so its sign-up pages can call this API.
APP_ORIGINS=http://localhost:8787,app://xstate
# Stalwart API key (Account → Credentials → API Keys on mx.xstate.com).
STALWART_API_KEY=
# Signs session JWTs (HS256). Any long random string: openssl rand -base64 48
JWT_SECRET=
# R2 for organization buckets (files). From the Cloudflare dashboard: R2 → Manage API tokens → Create API token,
# Object Read & Write, apply to all buckets. Leave empty to run without file storage.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Cloudflare API token with Account → Workers R2 Storage → Edit, to create organization buckets.
CLOUDFLARE_API_TOKEN=
# Signs Stalwart's webhook requests (X-Signature). Same value as the WebHook's signatureKey on Stalwart.
# Any long random string: openssl rand -base64 32
STALWART_WEBHOOK_SECRET=
# Amazon SES identity management (register customer domains). IAM user with ses:CreateEmailIdentity,
# GetEmailIdentity, DeleteEmailIdentity, SetIdentityNotificationTopic. Leave empty to skip SES registration.
AWS_SES_ACCESS_KEY_ID=
AWS_SES_SECRET_ACCESS_KEY=
