{
  "expo": {
    "name": "xstate",
    "slug": "xstate-mobile-app",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "xstate",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#09090b",
    "ios": {
      "bundleIdentifier": "com.xstate.app.dev",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.xstate.app.dev",
      "adaptiveIcon": {
        "backgroundColor": "#18181b",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-notifications",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#09090b",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 96
        }
      ]
    ],
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "experiments": {
      "reactCompiler": true
    },
    "owner": "xstatecom",
    "extra": {
      "eas": {
        "projectId": "6f6d0098-0e39-4d1c-8c34-cb6cdfe64d07"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/6f6d0098-0e39-4d1c-8c34-cb6cdfe64d07"
    }
  }
}
