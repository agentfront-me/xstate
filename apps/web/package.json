    "fumadocs-ui": "16.18.2",
    "next-themes": "0.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-server-dom-webpack": "19.3.1",
    "vinext": "1.4.4"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.67.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitejs/plugin-rsc": "0.5.39",
    "tailwindcss": "^4.3.5",
    "vite": "^8.3.6",
    "wrangler": "^4.158.0"
