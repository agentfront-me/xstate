    {
      "name": "api-cron",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@xstate/api",
        "exec",
        "wrangler",
        "dev",
        "--port",
        "8788",
        "--inspector-port",
        "9230",
        "--test-scheduled"
      ],
      "port": 8788
    },
    {
      "name": "app",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@xstate/app",
        "dev"
      ],
      "port": 8787
