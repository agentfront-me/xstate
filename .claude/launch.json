{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@xstate/api",
        "dev"
      ],
      "port": 8788
    },
    {
      "name": "app",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@xstate/app",
        "dev"
      ],
      "port": 8787
    },
    {
      "name": "web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@xstate/web",
        "dev"
      ],
      "port": 8785
    },
    {
      "name": "web-alt",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@xstate/web",
        "exec",
        "vite",
        "dev",
        "--port",
        "8786",
        "--strictPort"
      ],
      "port": 8786
    },
    {
      "name": "web-preview",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@xstate/web",
        "preview"
      ],
      "port": 8785
    },
    {
      "name": "api-audience",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@xstate/api",
        "exec",
        "wrangler",
        "dev",
        "--port",
        "8790",
        "--inspector-port",
        "9231",
        "--var",
        "APP_ORIGINS:http://localhost:8791,http://localhost:8787"
      ],
      "port": 8790
    },
    {
      "name": "app-audience",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "VITE_API_URL=http://localhost:8790/v1",
        "pnpm",
        "--filter",
        "@xstate/app",
        "exec",
        "vite",
        "--port",
        "8791",
        "--strictPort"
      ],
      "port": 8791
    },
    {
      "name": "api-agents",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@xstate/api",
        "exec",
        "wrangler",
        "dev",
        "--port",
        "8798",
        "--inspector-port",
        "9238",
        "--var",
        "APP_ORIGINS:http://localhost:8799"
      ],
      "port": 8798
    },
    {
      "name": "app-agents",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "VITE_API_URL=http://localhost:8798/v1",
        "pnpm",
        "--filter",
        "@xstate/app",
        "exec",
        "vite",
        "--port",
        "8799",
        "--strictPort"
      ],
      "port": 8799
    },
    {
      "name": "api-migration",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@xstate/api",
        "exec",
        "wrangler",
        "dev",
        "--port",
        "8793",
        "--inspector-port",
        "9232",
        "--var",
        "APP_ORIGINS:http://localhost:8792",
        "--var",
        "APP_URL:http://localhost:8792"
      ],
      "port": 8793
    },
    {
      "name": "app-migration",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "VITE_API_URL=http://localhost:8793/v1",
        "pnpm",
        "--filter",
        "@xstate/app",
        "exec",
        "vite",
        "--port",
        "8792",
        "--strictPort"
      ],
      "port": 8792
    }
  ]
}
